#lang rhombus/and_meta

// A "scope anchor" for the embedded editor snips.  Importing the Art 4
// vocabulary here (danceart re-exports facade; tonart4 adds `note`) and
// exporting a single identifier gives us a Racket syntax object whose
// lexical context carries all of those bindings -- `at`, `interval`,
// `facing`, `arm_diagram`, `note`, ...
//
// A snip's `read-special` parses its art string with `shrubbery/parse`
// (whose identifiers carry only shrubbery's own scopes, so they don't bind
// to facade), then re-applies THIS context with `datum->syntax`, making the
// parsed `at`/`arm_diagram`/... `free-identifier=?` to what the facade
// interpreter matches.  Any identifier works as the anchor -- `datum->syntax`
// copies the whole scope set regardless of the symbol.

import:
  danceart open
  tonart4 open

export: anchor

def anchor = 'anchor'
